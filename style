:root{
  --bg-dark:#0b1020; --card:#0f1724; --accent:#ff6b6b; --muted:#94a3b8; --glass:rgba(255,255,255,0.04);
  --glass-2:rgba(255,255,255,0.03); --success:#10b981;
}
*{box-sizing:border-box}
body{
  margin:0; font-family:Inter,system-ui,Segoe UI,Roboto,Arial; background:linear-gradient(180deg,#071124 0%,#0b1020 60%);
  color:#e6eef6; -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
}
.header{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;background:linear-gradient(90deg,#0b1220 0%, rgba(10,20,40,0.6) 100%);border-bottom:1px solid rgba(255,255,255,0.03)}
.brand{font-weight:700;display:flex;gap:10px;align-items:center}
.brand .logo{width:36px;height:36px;border-radius:8px;background:linear-gradient(135deg,var(--accent),#7c3aed);display:flex;align-items:center;justify-content:center;font-weight:800;color:white}
.top-actions{display:flex;gap:10px;align-items:center}
.btn{background:var(--accent);border:0;padding:8px 12px;border-radius:10px;color:white;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,0.4)}
.ghost{background:transparent;border:1px solid rgba(255,255,255,0.06);padding:8px 10px;border-radius:10px;color:var(--muted);cursor:pointer}
.container{max-width:1150px;margin:22px auto;padding:0 16px}
.top-row{display:flex;gap:16px;align-items:center;justify-content:space-between;margin-bottom:18px}
.search{flex:1;display:flex;gap:8px;align-items:center}
.search input{flex:1;padding:10px 12px;border-radius:10px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:#e6eef6}
.sectors{display:flex;gap:8px;flex-wrap:wrap}
.sector{background:var(--glass);padding:8px 12px;border-radius:10px;border:1px solid rgba(255,255,255,0.03);cursor:pointer;color:var(--muted)}
.sector.active{background:linear-gradient(90deg,#1f2937,#0f1724);border:1px solid rgba(255,255,255,0.06);box-shadow:0 8px 24px rgba(2,6,23,0.6);color:white}

.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.015));padding:12px;border-radius:12px;border:1px solid rgba(255,255,255,0.03);box-shadow:0 10px 30px rgba(2,6,23,0.6)}
.thumb{height:140px;border-radius:8px;background:linear-gradient(180deg,#071124,#0b1220);display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:10px}
.thumb img{width:100%;height:100%;object-fit:cover}
.title{font-weight:700;font-size:15px;margin-bottom:6px}
.desc{color:var(--muted);font-size:13px;margin-bottom:8px}
.price{color:var(--accent);font-weight:800;font-size:16px}
.card .actions{display:flex;gap:8px;margin-top:10px}

.cart-panel{position:fixed;right:18px;bottom:18px;width:340px;max-width:94%;background:linear-gradient(180deg, #071124, #071224);padding:12px;border-radius:12px;border:1px solid rgba(255,255,255,0.04);box-shadow:0 16px 40px rgba(2,6,23,0.6)}
.cart-panel h4{margin:0 0 10px 0}
.cart-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;color:var(--muted)}
.total{font-weight:800;color:var(--accent);margin-top:10px}

.footer{text-align:center;color:var(--muted);padding:24px 0}

/* modal */
.modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(2,6,23,0.6);z-index:90}
.modal .box{background:linear-gradient(180deg,#071124,#0a0f1a);padding:18px;border-radius:12px;width:100%;max-width:520px;border:1px solid rgba(255,255,255,0.04)}
.form-row{display:flex;gap:8px;margin-bottom:10px}
.form-row input, textarea, select{flex:1;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:#e6eef6}
.small{font-size:13px;color:var(--muted)}
.admin-top{display:flex;gap:8px;justify-content:flex-end;align-items:center}
.pill{background:rgba(255,255,255,0.03);padding:6px 10px;border-radius:999px;border:1px solid rgba(255,255,255,0.02);color:var(--muted)}

/* responsive adjustments */
@media(max-width:800px){
  .top-row{flex-direction:column;align-items:stretch}
  .cart-panel{width:92%;right:4%;left:4%}
}
